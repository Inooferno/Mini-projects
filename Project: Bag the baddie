# --- SPARA OCH LADDA FUNKTIONER ---
def spara_spel(nuvarande_scen):
    spar_data = {
        "scen": nuvarande_scen
    }
    with open("savegame.json", "w") as fil:
        json.dump(spar_data, fil)


def ladda_spel():
    if os.path.exists("savegame.json"):
        with open("savegame.json", "r") as fil:
            spar_data = json.load(fil)
            return spar_data["scen"]
    else:
        return None


